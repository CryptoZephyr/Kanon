{
  "name": "kanon",
  "version": "0.0.0",
  "private": true,
  "description": "Kanon repository bootstrap. Product logic is intentionally deferred.",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=11.5.0 <12.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "spike:privy": "node --env-file=.env.local --import=tsx apps/runner/src/privy-feasibility-spike.ts",
    "spike:privy:surface": "node --env-file=.env.local --import=tsx apps/runner/src/privy-surface-probes.ts",
    "spike:privy:compiler": "node --env-file=.env.local --import=tsx apps/runner/src/privy-policy-compiler-probe.ts",
    "spike:ens:t6": "node --env-file=.env.local --import=tsx apps/runner/src/ens-t6-write-probe.ts",
    "spike:ens:t7": "node --env-file=.env.local --import=tsx apps/runner/src/ens-t7-read-probe.ts",
    "spike:lifecycle:t8-t10": "node --import=tsx apps/runner/src/lifecycle-proof-probe.ts",
    "spike:lifecycle:t11-t13": "node --env-file=.env.local --import=tsx apps/runner/src/lifecycle-t11-t13-probe.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "eslint": "9.35.0",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
