{
  "name": "kanon",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "Kanon business agent-control runtime and approved frontend workspace.",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=11.5.0 <12.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "build:web": "pnpm --filter @kanon/web build",
    "dev:web": "pnpm --filter @kanon/web dev",
    "spike:privy": "node --env-file=.env.local --import=tsx apps/runner/src/privy-feasibility-spike.ts",
    "spike:privy:surface": "node --env-file=.env.local --import=tsx apps/runner/src/privy-surface-probes.ts",
    "spike:privy:compiler": "node --env-file=.env.local --import=tsx apps/runner/src/privy-policy-compiler-probe.ts",
    "spike:ens:t6": "node --env-file=.env.local --import=tsx apps/runner/src/ens-t6-write-probe.ts",
    "spike:ens:t7": "node --env-file=.env.local --import=tsx apps/runner/src/ens-t7-read-probe.ts",
    "spike:lifecycle:t8-t10": "node --import=tsx apps/runner/src/lifecycle-proof-probe.ts",
    "spike:lifecycle:t11-t13": "node --env-file=.env.local --import=tsx apps/runner/src/lifecycle-t11-t13-probe.ts",
    "smoke:live": "node --import=tsx apps/runner/src/live-judge-flow.ts",
    "e2e:ui": "node --import=tsx scripts/e2e-ui.mts"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.35.0",
    "playwright-core": "1.63.0",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  }
}
