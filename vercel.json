{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/kanon-proxy.ts": {
      "maxDuration": 120
    }
  },
  "routes": [
    {
      "src": "/api$",
      "dest": "/api/kanon-proxy?__kanon_path=/"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/kanon-proxy?__kanon_path=/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
